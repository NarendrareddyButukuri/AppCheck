# AppCheck Environment Configuration Template

PROJECT_NAME=AppCheck
TAGLINE="Know what an app can access."
VERSION=1.0.0
SECRET_KEY=appcheck-production-security-super-secret-key-32charsmin
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration:
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./appcheck.db
# Production PostgreSQL (Docker):
# DATABASE_URL=postgresql+asyncpg://appcheck:appcheck_secure_password_2026@localhost:5432/appcheck_db

# File limits
MAX_UPLOAD_SIZE_MB=150
